{
  "extends": "./tsconfig.base.json",
  "include": [
    "contracts/**/*.ts",
    "src/shared/**/*.ts",
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "mocks/**/*.ts",
    "scripts/**/*.ts",
    "test/**/*.ts",
    "electron.vite.config.ts",
    "vitest.config.ts"
  ],
  "exclude": ["**/* [0-9].*"],
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "lib": ["ES2023"],
    "types": ["node"]
  }
}
